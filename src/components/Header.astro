---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
