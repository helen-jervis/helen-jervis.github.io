---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="footer-name">{site.name}</p>
      <p>
        {site.jobTitle}<br />
        {site.employer}, {site.location}
      </p>
    </div>
    <div>
      <p class="label">Elsewhere</p>
      <ul>
        <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={site.links.weAreTechWomen}>WeAreTechWomen profile</a></li>
      </ul>
    </div>
    <p class="copyright">&copy; {new Date().getFullYear()} {site.name}</p>
  </div>
</footer>
